# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# pasta de assets brutos ("dropbox" de imagens fornecidas ao longo do projeto) — todo arquivo
# realmente usado no site já foi copiado para public/ com nome/local organizados; manter essa
# pasta fora do repo evita duplicar os mesmos assets em dois lugares (e evita publicar arquivos
# de rascunho/não usados num repositório público).
/empresas-logos/

# scripts de verificação/diagnóstico descartáveis (Playwright, um por checagem pontual durante o
# desenvolvimento) — não fazem parte do site, mantidos fora do repo público por organização.
/scripts/

# typescript
*.tsbuildinfo
next-env.d.ts
